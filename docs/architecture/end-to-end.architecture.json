  "cards": [
    {
      "dot": "cyan",
      "title": "Session ownership",
      "items": [
        "CLI creates or reuses an agent; Ticker continues the selected session.",
        "Folio uses one session per analysis; two workers claim durable jobs."
      ]
    },
    {
      "dot": "emerald",
      "title": "Completion contract",
      "items": [
        "Subscribe before input; require the completed root turn and matching command.",
        "Demos check request identity and helper integrity; Folio recalculates results."
      ]
    },
    {
      "dot": "rose",
      "title": "Folio access & recovery",
      "items": [
        "Oracle SSO, ownership checks and CSRF; Vault supplies live secrets.",
        "Uncertain work keeps IDs for review. Follow-ups cannot run commands."
      ]
    },
    {
      "dot": "amber",
      "title": "Separate paths & evidence",
      "items": [
        "OCI Responses uses its own curl client, OCI key and response IDs.",
        "Working-tree architecture, 25 Sep 2026. Live cloud execution was not tested."
      ]
    }
  ]
