# Create an application key in this OpenAI project. Never paste a real key in chat.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=proj_VD6ShY81c4nQ7iY3dFVuRzfo

# For OCI-backed sessions (the current config/environment.json default).
# Not required when explicitly selecting an OpenAI-hosted environment.
OPENAI_EXECUTOR_API_KEY=
OCI_SANDBOX_PROJECT_ID=
OCI_SANDBOX_PROFILE=Sandbox
OCI_SANDBOX_REGION=us-chicago-1
OCI_SANDBOX_RUNTIME=python-3.11
OCI_SANDBOX_SHAPE=SMALL

# Independent OCI-hosted model inference. These are OCI credentials, not OpenAI keys.
OCI_GENAI_API_KEY=
OCI_GENAI_PROJECT_ID=
OCI_GENAI_REGION=us-chicago-1
OCI_GENAI_MODEL=openai.gpt-6-astra
