# Copy non-secret deployment outputs here. Actual credentials stay in OCI Vault.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8780
APP_ORIGIN=http://127.0.0.1:8780
APP_BASE_PATH=
PORTFOLIO_REHEARSAL=0
OCI_AUTH_MODE=security_token
OCI_PROFILE=Sandbox
OCI_REGION=us-chicago-1
OCI_SANDBOX_REGION=us-chicago-1
OCI_SANDBOX_PROFILE=Sandbox
OCI_SANDBOX_PROJECT_ID=
OCI_VAULT_ID=
OCI_VAULT_KEY_ID=
OCI_COMPARTMENT_ID=
OCI_NAMESPACE=
OCI_OBJECT_BUCKET=
OPENAI_PROJECT_ID=
OPENAI_AGENT_ID=
OPENAI_BOOTSTRAP_SESSION_ID=
OPENAI_MODEL=gpt-5.6-luna
SSO_ISSUER_URL=
# Oracle's discovery endpoint can differ from its canonical token issuer.
SSO_DISCOVERY_URL=
# Set exactly one initial-admin identity on an empty directory. Never first-login wins.
# Approved email for a fresh rollout; existing account can use its verified private run ID.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_RUN_ID=
SSO_CLIENT_ID=
# Empty IDs deliberately fail startup until the dedicated rollout seeds Vault.
OPENAI_API_KEY='{"secretId":""}'
OPENAI_EXECUTOR_API_KEY='{"secretId":""}'
AUTH_SESSION_SECRET='{"secretId":""}'
SSO_CLIENT_SECRET='{"secretId":""}'
DATABASE_URL='{"secretId":""}'
